# airpods-ble — configuration (à déployer sur le RPi4, à côté de findmy-bridge)

# Mosquitto local. Même compte que findmy-bridge : l'ACL lui ouvre findmy/#.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=ha_user
MQTT_PASS=

TOPIC_PREFIX=findmy
HEARTBEAT_S=300
SILENCE_S=300

# 1 = journalise les trames décodées sans rien publier.
OBSERVE_ONLY=0
