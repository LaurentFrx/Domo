# atelier-bridge — configuration (à déployer sur le RPi4)

# python-matter-server. Le conteneur tourne en réseau `host` sur le RPi4, et le
# matter-server aussi → la boucle locale suffit, pas besoin de l'IP du LAN.
MATTER_WS_URL=ws://127.0.0.1:5580/ws

# Prises Matter (cf. SWITCH_NAMES dans src/lib/stores/matter.svelte.ts)
TOOL_NODE_ID=28
VACUUM_NODE_ID=29

# Hystérésis de détection de l'outil (W). DEUX seuils : voir le commentaire dans
# atelier_bridge.py. Valeurs à CALER SUR MESURE, pas au doigt mouillé.
ON_W=20
OFF_W=10

# Traînage après l'arrêt de l'outil (s)
OFF_DELAY_S=5

# 1 = le daemon journalise ce qu'il ferait, sans commander le relais.
OBSERVE_ONLY=0

STATE_PATH=/data/atelier_state.json
